# VoyageAI — Environment Variables
# Copy to .env and fill in your keys

# Required: OpenAI for LLM (all agents use this)
OPENAI_API_KEY=your_openai_api_key_here

# Required: OpenWeather API (weather server)
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Required: Tavily API (hotel/attraction search via streamable_http)
# Get free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Required: AviationStack API (flight data)
# Get free key at: https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Required: ExchangeRate API (currency conversion)
# Get free key at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
